{
  "name": "ton-better-auth",
  "version": "0.2.3",
  "description": "Better Auth plugin for TON Connect — sign in with TON wallets using ton_proof.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skills",
    "skills.sh.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "release": "npm run build && changeset publish",
    "version": "changeset version"
  },
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "ton",
    "ton-connect",
    "tonconnect",
    "tonkeeper",
    "wallet",
    "web3",
    "authentication",
    "ton_proof",
    "siwt"
  ],
  "author": "MonoBit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhbdev/ton-better-auth.git"
  },
  "bugs": {
    "url": "https://github.com/mhbdev/ton-better-auth/issues"
  },
  "homepage": "https://github.com/mhbdev/ton-better-auth#readme",
  "peerDependencies": {
    "@better-auth/core": "^1.7.7",
    "better-auth": "^1.7.7",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@better-auth/core": "^1.7.7",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
